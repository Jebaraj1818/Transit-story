# ==============================================================================
# THE TRANSIT STORY — FLASK + MYSQL ENVIRONMENT CONFIGURATION
# ==============================================================================

# Flask Core
FLASK_APP=backend.app:app
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=transit-story-super-secret-key-2026-production

# MySQL Database Connection (Local or Aiven Cloud MySQL)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=transit_story_db

# Optional Aiven SSL CA / URI configuration:
# DATABASE_URL=mysql+pymysql://avnadmin:PASSWORD@mysql-service.aivencloud.com:PORT/defaultdb?ssl_mode=REQUIRED
# DB_SSL_MODE=REQUIRED

# Brevo (Sendinblue) Transactional Email Service
# Get API key from Brevo Dashboard -> SMTP & API -> API Keys
BREVO_API_KEY=
BREVO_SENDER_EMAIL=transitstory.in@gmail.com
BREVO_SENDER_NAME=The Transit Story

# Optional Brevo Transactional Template IDs (Leave blank to use built-in branded HTML templates)
# BREVO_TEMPLATE_ADMIN_PASSWORD_RESET=1
# BREVO_TEMPLATE_ADMIN_PASSWORD_CHANGED=2
# BREVO_TEMPLATE_NEWSLETTER_WELCOME=3
# BREVO_TEMPLATE_ENQUIRY_CUSTOMER=4
# BREVO_TEMPLATE_ENQUIRY_ADMIN=5
# BREVO_TEMPLATE_CONTACT_CUSTOMER=6
# BREVO_TEMPLATE_CONTACT_ADMIN=7

# Application Base URL (used in email password reset links and admin buttons)
APP_BASE_URL=http://localhost:3000

# Vercel Blob Cloud Storage (Public media uploads)
# Generated in Vercel Dashboard -> Storage -> Create Blob Store
BLOB_READ_WRITE_TOKEN=

# Server port
PORT=5000

